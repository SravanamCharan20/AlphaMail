# Server
NODE_ENV=development
PORT=9000
CLIENT_ORIGIN=http://localhost:3000

# Database
MONGO_URL=mongodb://127.0.0.1:27017/alphamail

# Redis
# Prefer REDIS_URL in containers, for example: redis://redis:6379
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Auth
JWT_SECRET=replace-with-a-strong-secret

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9000/googleAuth/google/callback

# Pub/Sub
PUBSUB_TOPIC=
PUBSUB_PUSH_SERVICE_ACCOUNT=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_LABELS=INBOX
# Local/ngrok: leave unset (auth optional when Authorization is missing).
# Set PUBSUB_REQUIRE_AUTH=true to always demand OIDC JWT.
# Set PUBSUB_ALLOW_UNAUTHENTICATED_PUSH=true to skip JWT even in production (not recommended).
PUBSUB_REQUIRE_AUTH=
PUBSUB_ALLOW_UNAUTHENTICATED_PUSH=
# Worker safety net when Pub/Sub push delivery is flaky (ngrok/local).
# Set INCREMENTAL_POLL_ENABLED=false to disable.
INCREMENTAL_POLL_ENABLED=true
INCREMENTAL_POLL_MS=15000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Keep interactive inbox triage on the low-latency model. Override only when
# you explicitly prefer a slower, more capable triage model.
GEMINI_TRIAGE_MODEL=gemini-2.5-flash-lite
